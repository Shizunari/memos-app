<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Show-memo">
  <link rel="stylesheet" href="/assets/css/style.css">
  <title>show</title>
</head>
<body>
  <header>
    <h1>内容確認</h1>
  </header>
  <main>
    <div class="lines-view">
      <h2>タイトル</h2>
      <p><%= @article['title'] %></p>
      <h2>内容</h2>
      <p><%= @article['content'] %></p>
    </div>
  <div class="twice-container">
    <a class="btn02" href='/memos/<%= @id %>/edit'>編集</a>
    <form class="btn03" action="/memos/<%= @id %>" method="post">
      <input type="hidden" name="_method" value="delete">
      <input type="submit" value="削除">
    </form>
  </div>
</main>
<div class="moval-link">
  <a href="/memos">Back to memos</a>
</div>

</body>
</html>
