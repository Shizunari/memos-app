<header>
  <h1>内容確認</h1>
</header>
<main>
  <div class="lines-view">
    <h2>タイトル</h2>
    <p><%= @article['title'] %></p>
    <h2>内容</h2>
    <p><%= @article['content'] %></p>
  </div>
  <div class="twice-container">
    <a class="edit-btn" href='/memos/<%= @id %>/edit'>編集</a>
    <form class="delete-btn" action="/memos/<%= @id %>" method="post">
      <input type="hidden" name="authenticity_id" value="<%== @authenticity_id %>">
      <input type="hidden" name="_method" value="delete">
      <input type="submit" value="削除">
    </form>
  </div>
</main>
<div class="moval-link">
  <a href="/memos">Back to memos</a>
</div>
